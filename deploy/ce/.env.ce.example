# deploy/ce/.env.ce  — the CE secret source for the CUGA-events app.
# PLACEHOLDERS ONLY in this .example. Generate the real (gitignored) .env.ce with:
#     ./make_env_ce.sh            # copies the allow-listed keys out of ../../.env
# or copy this file to .env.ce and fill it in by hand. NEVER commit .env.ce.

# ---- LLM (watsonx; or use OPENAI_API_KEY instead) ----
WATSONX_APIKEY=xxxxxxxxxxxxxxxxxxxxxxxx
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=00000000-0000-0000-0000-000000000000
# OPENAI_API_KEY=sk-...
LLM_PROVIDER=watsonx
LLM_MODEL=meta-llama/llama-3-3-70b-instruct

# ---- Gateway (internal auth for /invoke callbacks) ----
GATEWAY_TOKEN=choose-a-long-random-string

# ---- Channels (direct backends; work on CE with no tunnel) ----
TELEGRAM_BOT_TOKEN=0000000000:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
EVENTS_TELEGRAM_BOT_USERNAME=your_bot
DISCORD_BOT_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx
SLACK_SIGNING_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Optional: inbound webhook shared key (enables /api/events/hook/...) ----
# EVENTS_WEBHOOK_KEY=choose-a-long-random-string
