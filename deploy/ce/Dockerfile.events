# CUGA event-driven layer (NO Activepieces) for IBM Code Engine.
# Extends the working root Dockerfile: same base + `uv sync`, with the registry pointed at the
# remote cuga-apps-mcp servers. One self-contained image — only the LLM + those (already-deployed)
# MCP routes are external.
#
# ONE IMAGE, TWO ROLES. 2_deploy.sh overrides the command per app:
#   cuga-core        uv run cuga start demo                     (the agent + UI + /run)
#   cuga-events-svc  uv run python -m cuga.backend.events.service (channels, concierge, scheduler)
# The CMD below is the cuga-core role, so a bare `docker run` of this image gives you plain CUGA.
#
# Built cloud-side by deploy/ce/1_build_push_image.sh (no local docker needed).

FROM python:3.12-slim-trixie

# curl + certs for the uv installer and outbound HTTPS to watsonx + the MCP routes.
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

ADD https://astral.sh/uv/install.sh /uv-installer.sh
RUN sh /uv-installer.sh && rm /uv-installer.sh
ENV PATH="/root/.local/bin/:$PATH"

WORKDIR /app

# Dependencies first (layer cache), then source.
COPY pyproject.toml uv.lock ./
COPY src/ ./src/
COPY docs/ ./docs/

# The alternative rosters live at the repo root; the default one (supervisor_agents.yaml) moved to
# docs/examples/events/ and already arrives with `COPY docs/` above.
COPY rosters/ ./rosters/

RUN uv sync

RUN mkdir -p /app/cuga_workspace
COPY src/cuga/demo_tools/huggingface/contacts.txt       /app/cuga_workspace/contacts.txt
COPY src/cuga/demo_tools/huggingface/cuga_knowledge.md  /app/cuga_workspace/cuga_knowledge.md
COPY src/cuga/demo_tools/huggingface/cuga_playbook.md   /app/cuga_workspace/cuga_playbook.md
COPY src/cuga/demo_tools/huggingface/email_template.md  /app/cuga_workspace/email_template.md

EXPOSE 7860

# Bind externally + pin the demo port to the CE-exposed port.
ENV CUGA_HOST=0.0.0.0
ENV DYNACONF_SERVER_PORTS__DEMO=7860

# Events (no-AP) defaults baked in; deploy-time --env can still override these.
ENV MCP_SERVERS_FILE=/app/src/cuga/backend/tools_env/registry/config/mcp_servers_cuga_apps.yaml
ENV EVENTS_SCHEDULER=native
ENV EVENTS_TELEGRAM_BACKEND=direct
ENV EVENTS_DISCORD_BACKEND=direct
ENV EVENTS_SLACK_BACKEND=direct

# Default role: vanilla CUGA — registry (8001) + agent (7860). The `--events` flag this used to
# carry is GONE: the eventing layer is no longer mounted onto this server, it is the separate
# service 2_deploy.sh starts as cuga-events-svc. Channel loops belong to that process, not this one.
CMD ["uv", "run", "cuga", "start", "demo"]
