AP_BASE_URL=http://127.0.0.1:8081
AP_CONTAINER_TYPE=WORKER_AND_APP
AP_DB_TYPE=PGLITE
AP_EMAIL=admin@cuga.local
AP_EXECUTION_MODE=UNSANDBOXED
AP_FRONTEND_URL=http://localhost:8081
AP_PIECES_SOURCE=OFFICIAL_AUTO
AP_PORT=8081
AP_QUEUE_MODE=REDIS
AP_REDIS_HOST=127.0.0.1
AP_REDIS_PORT=6379
AP_REDIS_TYPE=STANDALONE
AP_TELEMETRY_ENABLED=false
CUGA_COMPLIANCE_POC_SEED_ENABLED=1
CUGA_COMPLIANCE_POC_CATALOG_TIMEOUT_SECONDS=780
CUGA_DBS_DIR=/data/cuga/dbs
CUGA_DEMO_MODE=default
CUGA_HOST=0.0.0.0
CUGA_LOGGING_DIR=/data/cuga/logging
DYNACONF_CRM_DB_PATH=/data/cuga/crm/crm_db_default
DYNACONF_EVOLVE__ENABLED=true
DYNACONF_EVOLVE__MODE=direct
DYNACONF_EVOLVE__URL=http://127.0.0.1:8201/sse
DYNACONF_SERVER_PORTS__DEMO=7860
EVENTS_CUGA_PORT=7860
EVENTS_DB=/data/cuga/events.db
EVENTS_ENABLED=1
EVENTS_PIECES_WAIT=300
EVOLVE_HOOKS_CONFIG=/etc/cuga-poc/evolve-hooks.yaml
EVOLVE_PORT=8201
HOST_CALLBACK_URL=http://127.0.0.1:7860/invoke
