[Unit]
Description=Redis queue for the CUGA compliance PoC
After=cuga-poc-prepare.service
Requires=cuga-poc-prepare.service
Before=activepieces.service

[Service]
Type=simple
User=activepieces
Group=activepieces
ExecStart=/usr/local/bin/redis-server \
  --bind 127.0.0.1 \
  --protected-mode yes \
  --port 6379 \
  --dir /data/activepieces/redis \
  --appendonly yes \
  --supervised no
ExecStop=/usr/local/bin/redis-cli -h 127.0.0.1 shutdown
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
