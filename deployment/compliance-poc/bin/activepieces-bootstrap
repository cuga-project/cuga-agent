#!/usr/bin/python3.12
"""Create the PoC Activepieces owner, then install the baked piece archives.

Activepieces normally resolves its catalog from cloud.activepieces.com and
pulls each package from npm, which a restricted cluster blocks. The image
bakes the piece tarballs instead and this uploads them through the local API
as ARCHIVE packages, so the PoC never reaches the public internet and does
not wait out the multi-minute cloud catalog import.

Archive installs register as CUSTOM pieces, which the cloud sync's reaper
deliberately leaves alone, so they survive even if syncing is turned back on.
"""

from __future__ import annotations

import json
import mimetypes
import os
import secrets
import time
import urllib.error
import urllib.request
from pathlib import Path


BASE = os.environ.get("AP_BASE_URL", "http://127.0.0.1:8081").rstrip("/")
PIECES_DIR = Path(os.environ.get("AP_PIECES_ARCHIVE_DIR", "/etc/cuga-poc/pieces"))
MANIFEST = PIECES_DIR / "pieces.json"
READY_TIMEOUT_SECONDS = 300


def request(
    path: str,
    method: str = "GET",
    body: dict | None = None,
    token: str | None = None,
    data: bytes | None = None,
    content_type: str | None = None,
    timeout: int = 60,
) -> tuple[int, str]:
    headers = {}
    if body is not None:
        data = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"
    elif content_type:
        headers["Content-Type"] = content_type
    if token:
        headers["Authorization"] = f"Bearer {token}"
    req = urllib.request.Request(f"{BASE}{path}", data=data, method=method, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as response:
            return response.status, response.read().decode()
    except urllib.error.HTTPError as error:
        return error.code, error.read().decode()


def multipart(fields: dict[str, str], filename: str, payload: bytes) -> tuple[bytes, str]:
    """Encode the exact form the Activepieces web client posts for an archive."""
    boundary = f"----cuga{secrets.token_hex(16)}"
    marker = f"--{boundary}".encode()
    chunks: list[bytes] = []
    for key, value in fields.items():
        chunks += [
            marker,
            f'Content-Disposition: form-data; name="{key}"'.encode(),
            b"",
            value.encode(),
        ]
    content_type = mimetypes.guess_type(filename)[0] or "application/octet-stream"
    chunks += [
        marker,
        f'Content-Disposition: form-data; name="pieceArchive"; filename="{filename}"'.encode(),
        f"Content-Type: {content_type}".encode(),
        b"",
        payload,
        f"--{boundary}--".encode(),
        b"",
    ]
    return b"\r\n".join(chunks), f"multipart/form-data; boundary={boundary}"


def wait_for_activepieces() -> None:
    deadline = time.monotonic() + READY_TIMEOUT_SECONDS
    while time.monotonic() < deadline:
        try:
            if request("/api/v1/flags", timeout=20)[0] == 200:
                return
        except OSError:
            pass
        time.sleep(2)
    raise SystemExit(f"Activepieces did not become ready at {BASE}")


def ensure_owner(email: str, password: str) -> None:
    status, response = request(
        "/api/v1/authentication/sign-up",
        "POST",
        {
            "email": email,
            "password": password,
            "firstName": "CUGA",
            "lastName": "Administrator",
            "trackEvents": False,
            "newsLetter": False,
        },
    )
    already_registered = status == 403 and "INVITATION_ONLY_SIGN_UP" in response
    if status not in {200, 201, 409} and not already_registered:
        raise SystemExit(f"Activepieces owner bootstrap failed (HTTP {status}): {response[:300]}")


def sign_in(email: str, password: str) -> str:
    status, response = request(
        "/api/v1/authentication/sign-in", "POST", {"email": email, "password": password}
    )
    token = json.loads(response).get("token") if status == 200 else None
    if not token:
        raise SystemExit(f"Activepieces sign-in failed (HTTP {status}): {response[:300]}")
    return token


def installed(name: str, token: str) -> bool:
    # Archive installs are PLATFORM-scoped CUSTOM pieces, so the lookup only
    # resolves them when the request carries the owner's token. Anonymously
    # this 404s for pieces that are in fact installed.
    return request(f"/api/v1/pieces/{name}", token=token, timeout=20)[0] == 200


def install(name: str, version: str, archive: Path, token: str) -> None:
    data, content_type = multipart(
        {
            "packageType": "ARCHIVE",
            "pieceName": name,
            "pieceVersion": version,
            "scope": "PLATFORM",
        },
        archive.name,
        archive.read_bytes(),
    )
    status, response = request(
        "/api/v1/pieces",
        "POST",
        token=token,
        data=data,
        content_type=content_type,
        timeout=180,
    )
    if status not in {200, 201, 409}:
        raise SystemExit(f"installing {name}@{version} failed (HTTP {status}): {response[:300]}")


def main() -> None:
    if not MANIFEST.exists():
        raise SystemExit(f"no baked piece manifest at {MANIFEST}")
    manifest = json.loads(MANIFEST.read_text())

    wait_for_activepieces()
    email = os.environ["AP_EMAIL"]
    password = os.environ["AP_PASSWORD"]
    ensure_owner(email, password)
    token = sign_in(email, password)

    for name, entry in sorted(manifest.items()):
        if installed(name, token):
            print(f"{name} already installed")
            continue
        archive = PIECES_DIR / entry["archive"]
        if not archive.is_file():
            raise SystemExit(f"{name} is in the manifest but {archive} is missing")
        print(f"installing {name}@{entry['version']} from {archive.name}")
        install(name, entry["version"], archive, token)

    missing = sorted(name for name in manifest if not installed(name, token))
    if missing:
        raise SystemExit(f"pieces still unresolved after install: {missing}")
    print(f"all {len(manifest)} required pieces present")


if __name__ == "__main__":
    main()
