#!/usr/bin/python3.12
"""Resolve PoC configuration and secrets, then exec the service supervisor.

Runs under an arbitrary non-root UID. It never chowns, writes only under
/data, and registers the effective UID in /etc/passwd so tools that look
the account up by uid keep working on OpenShift, which assigns a UID that
has no entry in the image.

Service configuration is merged here and handed to the supervisor through
the process environment, so nothing needs to be written to /etc at runtime.
"""

from __future__ import annotations

import errno
import os
import pwd
import secrets
import sys
from pathlib import Path


STATE_DIR = Path("/data/cuga-poc")
SECRETS_FILE = STATE_DIR / "secrets.env"
DEFAULTS_FILE = Path("/etc/cuga-poc/defaults.env")
PASSWD_FILE = Path("/etc/passwd")
FALLBACK_HOME = "/data/cuga/home"
GENERATED = {
    "AP_ENCRYPTION_KEY": lambda: secrets.token_hex(16),
    "AP_JWT_SECRET": lambda: secrets.token_hex(32),
    "AP_PASSWORD": lambda: secrets.token_urlsafe(24),
    # Unset, the events layer accepts any POST to /api/events/hook/<name>,
    # including one carrying a wrong ?key=. Generating it here closes that on
    # a pod published through a Route without asking the operator for anything.
    "EVENTS_WEBHOOK_KEY": lambda: secrets.token_urlsafe(32),
    "GATEWAY_TOKEN": lambda: secrets.token_urlsafe(32),
}
EXACT_KEYS = {
    "AGENT_SETTING_CONFIG",
    "ANTHROPIC_API_KEY",
    "GROQ_API_KEY",
    "HOST_CALLBACK_URL",
    "LLM_MODEL",
    "LLM_PROVIDER",
    "MODEL_NAME",
    "OPENAI_API_KEY",
    "OPENAI_BASE_URL",
    "SIL_API_KEY",
    "WATSONX_APIKEY",
    "WATSONX_PROJECT_ID",
    "WATSONX_URL",
}
PREFIXES = ("AP_", "CUGA_", "DYNACONF_", "EVENTS_", "EVOLVE_")
POC_WIRING = {
    "AP_BASE_URL": "http://127.0.0.1:8081",
    "CUGA_COMPLIANCE_POC_SEED_ENABLED": "1",
    "DYNACONF_EVOLVE__ENABLED": "true",
    "DYNACONF_EVOLVE__MODE": "direct",
    "DYNACONF_EVOLVE__URL": "http://127.0.0.1:8201/sse",
    "EVENTS_ENABLED": "1",
}


def read_env(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    if not path.exists():
        return values
    for raw in path.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        values[key] = value.strip().strip('"')
    return values


def quote(value: str) -> str:
    if "\n" in value or "\r" in value:
        raise ValueError("multiline environment values are not supported")
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'


def write_env(path: Path, values: dict[str, str], mode: int) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    content = "".join(f"{key}={quote(value)}\n" for key, value in sorted(values.items()))
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(content)
    temporary.chmod(mode)
    temporary.replace(path)


def ensure_passwd_entry() -> None:
    """Give the effective UID a passwd entry when the image has none.

    OpenShift runs the container as a random UID from the namespace range.
    Group 0 owns /etc/passwd and the image makes it group-writable, so the
    entry can be appended without any capability.
    """
    uid = os.geteuid()
    try:
        pwd.getpwuid(uid)
        return
    except KeyError:
        pass
    entry = f"cuga:x:{uid}:{os.getegid()}:CUGA compliance PoC:{FALLBACK_HOME}:/sbin/nologin\n"
    try:
        with PASSWD_FILE.open("a") as handle:
            handle.write(entry)
    except OSError as error:
        if error.errno not in {errno.EACCES, errno.EPERM, errno.EROFS}:
            raise
        print(
            f"[entrypoint] warning: uid {uid} has no passwd entry and "
            f"{PASSWD_FILE} is not writable",
            file=sys.stderr,
            flush=True,
        )


def resolve_environment() -> dict[str, str]:
    """Merge configuration lowest precedence first.

    Image defaults lose to persisted secrets, which lose to values supplied
    on the container, which lose to the wiring this PoC topology requires.
    """
    resolved = read_env(DEFAULTS_FILE)

    persisted = read_env(SECRETS_FILE)
    for key, factory in GENERATED.items():
        persisted[key] = os.environ.get(key) or persisted.get(key) or factory()
    # 0660, not 0600: a redeployed pod may come back under a different UID
    # and must still read the credentials it generated, via group 0.
    write_env(SECRETS_FILE, persisted, 0o660)
    resolved.update(persisted)

    resolved.update(
        {
            key: value
            for key, value in os.environ.items()
            if key in EXACT_KEYS or key.startswith(PREFIXES)
        }
    )
    resolved.update(POC_WIRING)
    return resolved


def main() -> None:
    # Group 0 is shared by every process in the pod, so state written by one
    # service has to stay readable and writable by the others.
    os.umask(0o002)
    ensure_passwd_entry()
    STATE_DIR.mkdir(parents=True, exist_ok=True)

    environment = dict(os.environ)
    environment.update(resolve_environment())
    environment.setdefault("HOME", FALLBACK_HOME)

    command = sys.argv[1:] or ["/usr/local/bin/cuga-poc-supervisor"]
    os.execvpe(command[0], command, environment)


if __name__ == "__main__":
    main()
