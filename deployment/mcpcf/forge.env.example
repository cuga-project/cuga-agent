# Context Forge PoC — env file for deployment/mcpcf/*.sh
# Copy to forge.env and fill in. Never commit forge.env (it holds secrets).

# ---------------------------------------------------------------------------
# Cluster / tenant
# ---------------------------------------------------------------------------
# The tenant this PoC piggybacks on — same tenant as the CUGA agent being
# cloned in Track E. Forge gets its own namespace inside the same cluster,
# NOT the tenant namespace itself.
NAMESPACE=mcpcf-poc
TENANT_ID=943565d1-768a-4bbc-8ba7-2bf966d3bb5e
CLUSTER_DOMAIN=gori-cuga-agent1.cp.fyre.ibm.com

# ---------------------------------------------------------------------------
# Images
# ---------------------------------------------------------------------------
FORGE_IMAGE=ghcr.io/ibm/mcp-context-forge:latest
# Reused for the demo MCP server (see manifests/60-demo-mcp) — same image the
# tenant's CUGA agents already run, fastmcp is already a dependency.
CUGA_IMAGE=registry-quay-quay-enterprise.apps.gori-agent-hub.cp.fyre.ibm.com/sovcloud/automation-saas-platform-dev/cuga:0.3.1
# Only set this if pods in the new namespace can't pull CUGA_IMAGE with no
# imagePullSecret (the tenant namespace's agents pull it via what looks like
# a node-level credential, not a per-pod secret — unconfirmed for a fresh
# namespace until 02-deploy-demo-mcp.sh actually runs).
PULL_SECRET=

# ---------------------------------------------------------------------------
# Forge — required secrets
# ---------------------------------------------------------------------------
# Generate both with: python3 -m mcpgateway.scripts.init_secrets  (from a
# Forge checkout), or `openssl rand -hex 32`. Must not be the __REPLACE_ME__
# placeholder or a low-entropy string — Forge refuses to start otherwise.
JWT_SECRET_KEY=
AUTH_ENCRYPTION_SECRET=

# NOT a .local (or other non-public-suffix) domain — Forge's EmailStr
# validator rejects it with a 422 "An error occurred, please try again."
# that gives no hint it's the TLD (confirmed live: same password, only the
# domain changed, and email/password auth started working). Use something
# that looks like a real domain even if it doesn't resolve.
PLATFORM_ADMIN_EMAIL=admin@mcpcf-poc.example.com
PLATFORM_ADMIN_PASSWORD=
BASIC_AUTH_PASSWORD=

# ---------------------------------------------------------------------------
# Postgres / Redis — Forge's own, fresh instances (NOT the tenant's shared
# Postgres — that one stays untouched, Track E's agent clone reuses it as-is)
# ---------------------------------------------------------------------------
# NOT "postgres" — the sclorg postgresql image special-cases that name as
# "just set the superuser password", and skips creating POSTGRES_DB entirely
# (confirmed live: \dt / \l showed no such database, Forge's DATABASE_URL
# then pointed at nothing). Any other name makes the image create both the
# role and the database, matching what the upstream Forge OpenShift guide's
# oc new-app example actually needs (their example's "postgres" value for
# this doesn't work with this image, at least at the c9s tag pulled 2026-08-26).
POSTGRES_USER=forge
POSTGRES_PASSWORD=
POSTGRES_DB=mcp
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Option A auth wiring (Track B — 03-configure-forge.sh / 04-mint-token.sh)
# ---------------------------------------------------------------------------
BROKER_MODE=mock                 # real | mock — see poc-plan.md Track B
BROKER_ISSUER=
BROKER_JWKS_URI=
MCP_AUDIENCE=mcp-gw.943565d1-768a-4bbc-8ba7-2bf966d3bb5e
WORKSPACE_ID=poc-workspace-1

# ---------------------------------------------------------------------------
# Cloned CUGA agent (Track E — 10-clone-agent.sh)
# ---------------------------------------------------------------------------
# The image carrying the Track C tool browser. Built in-cluster by default
# (see scratchpad.md Track D) — swap for a ghcr.io ref if you publish instead.
CLONE_IMAGE=
CLONE_NAME=poc-forge-agent
CLONE_AGENT_ID=poc-forge-agent
# Which running agent to clone. Empty = auto-pick the first CugaAgent-owned
# Deployment in tenant-$TENANT_ID. Set explicitly to pin one.
SOURCE_AGENT=
