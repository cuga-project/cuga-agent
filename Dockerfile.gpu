# GPU variant of Dockerfile. CUDA + cuDNN runtime base so onnxruntime-gpu finds
# its libs at import time. Build on a CUDA host and run with `--gpus all`:
#   docker build -f Dockerfile.gpu -t cuga:gpu .
#   docker run --gpus all -e CUGA_GPU_BUILD=1 -p 7860:7860 cuga:gpu
# Set use_gpu = true (default) and the knowledge engine auto-detects CUDA.
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

# Same OCR stack as the CPU image (see Dockerfile for the language-pack rationale).
# uv brings its own managed CPython, so no system python install is needed.
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates \
        tesseract-ocr tesseract-ocr-osd \
        tesseract-ocr-eng tesseract-ocr-heb tesseract-ocr-ara \
        tesseract-ocr-rus tesseract-ocr-ell tesseract-ocr-hin \
        tesseract-ocr-tha tesseract-ocr-jpn tesseract-ocr-kor \
        tesseract-ocr-chi-sim && \
    rm -rf /var/lib/apt/lists/*

ADD https://astral.sh/uv/install.sh /uv-installer.sh
RUN sh /uv-installer.sh && rm /uv-installer.sh
ENV PATH="/root/.local/bin/:$PATH"

WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY src/ ./src/
COPY docs/ ./docs/

# GPU runtime: install onnxruntime-gpu and SKIP the CPU onnxruntime so it can't
# shadow it (both ship the same `onnxruntime` module). Lockfile-managed — no
# bolt-on `uv pip install` that a later `uv sync` would silently revert.
RUN uv sync --extra gpu --no-install-package onnxruntime

# Flags the GPU image so `cuga`'s GPU doctor reports honestly when no device is visible.
ENV CUGA_GPU_BUILD=1

RUN mkdir -p /app/cuga_workspace
COPY src/cuga/demo_tools/huggingface/contacts.txt /app/cuga_workspace/contacts.txt
COPY src/cuga/demo_tools/huggingface/cuga_knowledge.md /app/cuga_workspace/cuga_knowledge.md
COPY src/cuga/demo_tools/huggingface/cuga_playbook.md /app/cuga_workspace/cuga_playbook.md
COPY src/cuga/demo_tools/huggingface/email_template.md /app/cuga_workspace/email_template.md

EXPOSE 7860
ENV CUGA_HOST=0.0.0.0
ENV DYNACONF_SERVER_PORTS__DEMO=7860

CMD ["uv", "run", "cuga", "start", "demo_crm", "--cuga-workspace", "/app/cuga_workspace"]
