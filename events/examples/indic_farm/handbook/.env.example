# The handbook index. ingest.py and handbook_mcp.py must agree on these — the embedding model is part
# of the collection name. cuga_compat.py makes CUGA honour the model (its RAG profile otherwise wins).
DYNACONF_KNOWLEDGE__EMBEDDINGS__MODEL=intfloat/multilingual-e5-large
# multilingual-e5-large's weights do not load on the Apple-Silicon GPU path; CPU works everywhere.
DYNACONF_KNOWLEDGE__EMBEDDINGS__USE_GPU=false
# CugaAgent needs a model config to start (no LLM is called by the tool itself).
AGENT_SETTING_CONFIG=settings.watsonx.toml
# Where .cuga/knowledge lives (default: this folder).
# FARM_KB_DIR=
