# ═══════════════════════════════════════════════════════════════════════════
#  CUGA event-driven agents — .env TEMPLATE
#
#  Copy to .env and fill in your values:   cp .env.events.example .env
#  (.env is gitignored — your real secrets never get committed.)
#
#  Organised in two halves:
#    NON-ACTIVEPIECES (top) — everything the AP-free stack needs: core, LLM, the
#                             direct channels (Slack/Discord/Telegram), native
#                             cron/poll, and Box-direct. Works with NO Activepieces.
#    ACTIVEPIECES     (bottom) — only for SaaS *push* triggers (Gmail/GitHub/Box-OAuth/
#                             Google-Calendar/Pinterest). Skip it entirely if you don't
#                             use those.
#
#  TENANT = one value for the whole deployment · USER = your personal login (per-user).
#  The Studio reads this file: a set value shows "configured ✓"; a missing one offers a wizard.
#
#  ┄┄ HOW TO GET EACH CREDENTIAL (step-by-step guides) ┄┄
#    Full runbook ............ events_docs/SETUP.md          Check them all: `make doctor`
#    Per-connector index ..... events_docs/setup/README.md   (+ the TENANT/USER model)
#    LLM (watsonx/openai/…) .. README.md → "Configuration Priority"
#    Telegram · Slack · Discord · Box · GitHub · Gmail · Webhook → events_docs/setup/<APP>.md
#    Sanity-check the file has all required keys (offline):  `make env-check`
# ═══════════════════════════════════════════════════════════════════════════


# ███████████████████████  NON-ACTIVEPIECES  ███████████████████████████████
# The AP-free stack. Channels + native cron/poll need nothing below the AP line.

# ── platform / core (TENANT) ──
EVENTS_ENABLED=1
EVENTS_SEED_AGENTS=1
EVENTS_SUPERVISOR=1                                               # ONE cuga supervisor; sub-agents from supervisor_agents.yaml
EVENTS_DB=/absolute/path/to/cuga-agent/events.db                 # persist subs/identity across restarts
GATEWAY_TOKEN=replace-with-a-random-secret-openssl-rand-hex-16   # /invoke auth secret (same value both sides)

# ── LLM (TENANT) ──   setup → README.md "Configuration Priority" (watsonx/openai/azure/groq/…)
LLM_PROVIDER=watsonx
LLM_MODEL=openai/gpt-oss-120b
AGENT_SETTING_CONFIG=settings.watsonx.toml
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=<your-watsonx-project-id>                     # or WATSONX_SPACE_ID
WATSONX_APIKEY=<your-watsonx-api-key>

# ── public HTTPS URL (TENANT) ──   needed for Slack's inbound webhook (direct) + OAuth callbacks.
#    NOT needed for Telegram/Discord (outbound) or native cron/poll. Auto-detected from the live CUGA
#    tunnel by events_up.sh; set a NON-trycloudflare value to PIN a stable one. `make public-url` prints it.
EVENTS_PUBLIC_URL=https://<your-cuga-tunnel>.trycloudflare.com
# Stable URL (stops flapping): reserve a free ngrok domain at dashboard.ngrok.com/domains (verify email
# first), set below; events_up.sh serves :8100 on it and pins EVENTS_PUBLIC_URL. Set Slack's URL ONCE.
# EVENTS_NGROK_DOMAIN=your-name.ngrok-free.app

# ── Channels — DIRECT backends, no AP (TENANT bot + USER target) ──
#    Telegram → setup/TELEGRAM.md (@BotFather) · Discord → setup/DISCORD.md (MESSAGE CONTENT INTENT)
#    · Slack → setup/SLACK.md (api.slack.com/apps)
EVENTS_SLACK_CHAT=mention                                        # only @bot / DMs / replies reach chat (watchers unaffected)
EVENTS_DISCORD_CHAT=mention
# EVENTS_DISCORD_MEMBERS_INTENT=1                                # enable if you watch new-member events
TELEGRAM_BOT_TOKEN=<botfather-token>
EVENTS_TELEGRAM_BOT_USERNAME=<your_bot_username>                 # must match the bot exactly (deep-link /start)
# TELEGRAM_CHAT_ID=<your-telegram-chat-id>                       # [USER] your personal chat id (DM/capture target)
DISCORD_BOT_TOKEN=<discord-bot-token>
SLACK_BOT_TOKEN=xoxb-<your-slack-bot-token>
# SLACK_SIGNING_SECRET=                                          # optional — locks Slack request verification
# EVENTS_SLACK_BACKEND=                                          # unset = direct (default). "ap" = the parked AP path
# EVENTS_DISCORD_BACKEND=                                        # unset = direct gateway (default). "ap" = AP polling

# ── Box — DIRECT token poll, no AP (USER, opt-in) ──   setup → events_docs/setup/BOX.md
#    (Box's *OAuth/AP* path lives in the ACTIVEPIECES section below — this is the AP-free alternative.)
EVENTS_BOX_BACKEND=direct                                        # direct token poll. unset/"ap" = AP OAuth push
# BOX_DEV_TOKEN=<box-dev-token>                                  # EXPIRES ~60 min — regenerate in the Box console
# BOX_FOLDER_ID=<box-folder-id>                                  # the folder the direct poller watches


# ███████████████████████  ACTIVEPIECES  ███████████████████████████████████
# ONLY for SaaS push triggers (Gmail/GitHub/Box-OAuth/Google-Calendar/Pinterest).
# Nothing here is required for channels or native cron/poll — leave it blank to run AP-free.

# ── AP admin / infra (TENANT) ──   setup → events_docs/SETUP.md §2
#    You INVENT AP_EMAIL/AP_PASSWORD; the script signs this admin up on AP's first boot, and you reuse
#    them to log into the AP UI at http://localhost:8081. AP needs a strong password.
AP_BASE_URL=http://localhost:8081
AP_EMAIL=you@example.com
AP_PASSWORD=Sup3rSecret!                                         # ≥8 chars, mixed case + number + symbol
HOST_CALLBACK_URL=http://host.containers.internal:8100/invoke    # how AP reaches CUGA (Docker: host.docker.internal)
EVENTS_AP_PROJECT_GRAIN=shared

# ── OAuth APP registrations — client id/secret, ONE app per org (TENANT) ──
#    These identify the deployment to the vendor; CUGA hosts the connect flow, the per-USER token is
#    then stored in AP (ea::<tenant>::<user>::<app>). Box → setup/BOX.md · Slack → setup/SLACK.md ·
#    Gmail (redirect-URI/consent saga) → setup/GMAIL.md · GitHub → setup/GITHUB.md
# EVENTS_OAUTH_BOX_CLIENT_ID=<box-client-id>
# EVENTS_OAUTH_BOX_CLIENT_SECRET=<box-client-secret>
# EVENTS_OAUTH_SLACK_CLIENT_ID=<slack-client-id>
# EVENTS_OAUTH_SLACK_CLIENT_SECRET=<slack-client-secret>
EVENTS_OAUTH_SLACK_SCOPES=chat:write channels:read channels:history
# EVENTS_OAUTH_GMAIL_CLIENT_ID=<gmail-client-id>.apps.googleusercontent.com
# EVENTS_OAUTH_GMAIL_CLIENT_SECRET=<gmail-client-secret>
# EVENTS_OAUTH_GOOGLE_CALENDAR_CLIENT_ID=<gcal-client-id>.apps.googleusercontent.com
# EVENTS_OAUTH_GOOGLE_CALENDAR_CLIENT_SECRET=<gcal-client-secret>
# EVENTS_OAUTH_GITHUB_CLIENT_ID=<github-oauth-client-id>
# EVENTS_OAUTH_GITHUB_CLIENT_SECRET=<github-oauth-client-secret>
# EVENTS_OAUTH_PINTEREST_CLIENT_ID=<pinterest-app-id>
# EVENTS_OAUTH_PINTEREST_CLIENT_SECRET=<pinterest-app-secret>

# ── Per-USER SaaS tokens (AP integration triggers) ──
#    GitHub → your PAT (repo scope), setup → events_docs/setup/GITHUB.md (or connect in the Studio).
# GITHUB_TOKEN=<github-pat>
#    Gmail / Google-Calendar / Pinterest — NO static token: OAuth. Set the app creds above, then log in
#    ONCE via the Studio wizard (Integrations → Connect); the token is stored in AP. → setup/GMAIL.md
