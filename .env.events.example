# ═══════════════════════════════════════════════════════════════════════════
#  CUGA event-driven agents — .env TEMPLATE
#
#  Copy to .env and fill in your values:   cp .env.events.example .env
#  (.env is gitignored — your real secrets never get committed.)
#
#  TENANT  = one value for the whole deployment (shared by everyone).
#  USER    = your personal login (per-user). In a single-operator setup these
#            are just yours; in multi-user, leave the USER ones blank and each
#            person connects their own in the Studio (Integrations → Connect).
#
#  The Studio reads this file: a value that's set shows as "configured ✓";
#  a missing one offers a setup wizard.
#
#  ┄┄ HOW TO GET EACH CREDENTIAL (the painful bits — step-by-step guides) ┄┄
#    Full runbook ............ events_docs/SETUP.md
#    Per-connector index ..... events_docs/setup/README.md   (+ the TENANT/USER model)
#    LLM (watsonx/openai/…) .. README.md  →  "Configuration Priority"
#    Activepieces admin ...... events_docs/SETUP.md  §2  (you INVENT these; script makes the admin)
#    Telegram ................ events_docs/setup/TELEGRAM.md      Slack ... events_docs/setup/SLACK.md
#    Discord ................. events_docs/setup/DISCORD.md       Box ..... events_docs/setup/BOX.md
#    GitHub .................. events_docs/setup/GITHUB.md        Gmail ... events_docs/setup/GMAIL.md
#    Webhook ................. events_docs/setup/WEBHOOK.md
#  Each guide is: procure → wire → verify → troubleshoot. Check them all at once: `make doctor`.
#  Sanity-check the file has all required keys (offline):            `make env-check`
# ═══════════════════════════════════════════════════════════════════════════


# ───────────────────────────────  TENANT  ─────────────────────────────────
# One-per-org values: infra, the LLM, Activepieces, bot tokens, OAuth *apps*.

# ── platform / infra (TENANT) ──
EVENTS_ENABLED=1
EVENTS_SEED_AGENTS=1
EVENTS_DB=/absolute/path/to/cuga-agent/events.db                 # persist subs/identity across restarts
EVENTS_AP_PROJECT_GRAIN=shared
GATEWAY_TOKEN=pick-any-random-string                             # /invoke auth secret (same value both sides)
HOST_CALLBACK_URL=http://host.containers.internal:8100/invoke    # how AP reaches CUGA (Docker: host.docker.internal)
# public HTTPS base (Slack Request URL + OAuth callbacks). Auto-detected from the live CUGA tunnel by
# events_up.sh — leave the placeholder; `make public-url` prints the real one. Set a NON-trycloudflare
# URL to PIN a stable/named tunnel (then it's respected as-is).
EVENTS_PUBLIC_URL=https://<your-cuga-tunnel>.trycloudflare.com
# RECOMMENDED — stop the flapping with a stable URL: reserve a free ngrok domain at
# dashboard.ngrok.com/domains (verify email first), set it below; events_up.sh serves :8100 on it and
# pins EVENTS_PUBLIC_URL. Configure Slack/Gmail ONCE and never re-point them again.
# EVENTS_NGROK_DOMAIN=your-name.ngrok-free.app

# ── LLM (TENANT) ──   setup → README.md "Configuration Priority" (watsonx/openai/azure/groq/…)
LLM_PROVIDER=watsonx
LLM_MODEL=openai/gpt-oss-120b
AGENT_SETTING_CONFIG=settings.watsonx.toml
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=<your-watsonx-project-id>                     # or WATSONX_SPACE_ID
WATSONX_APIKEY=<your-watsonx-api-key>

# ── Activepieces admin (TENANT) ──   setup → events_docs/SETUP.md §2
#    You INVENT AP_EMAIL/AP_PASSWORD; the script signs this admin up on AP's first boot, and you
#    reuse them to log into the AP UI at http://localhost:8081. AP needs a strong password.
AP_BASE_URL=http://localhost:8081
AP_EMAIL=you@example.com
AP_PASSWORD=Sup3rSecret!                                         # ≥8 chars, mixed case + number + symbol

# ── Channel bot tokens — ONE bot per org (TENANT) ──
#    Telegram → events_docs/setup/TELEGRAM.md (@BotFather) · Discord → events_docs/setup/DISCORD.md
#    (dev portal + MESSAGE CONTENT INTENT) · Slack → events_docs/setup/SLACK.md (api.slack.com/apps)
TELEGRAM_BOT_TOKEN=<botfather-token>
EVENTS_TELEGRAM_BOT_USERNAME=<your_bot_username>                 # must match the bot exactly (deep-link /start)
DISCORD_BOT_TOKEN=<discord-bot-token>
SLACK_BOT_TOKEN=xoxb-<your-slack-bot-token>
# SLACK_SIGNING_SECRET=                          # optional — locks Slack request verification

# ── OAuth APP registrations — client id/secret, ONE app per org (TENANT) ──
#    These identify the deployment to the vendor. The per-USER *login* is separate (see USER below).
#    Box OAuth → events_docs/setup/BOX.md · Slack OAuth → events_docs/setup/SLACK.md
#    Gmail OAuth (the painful one — redirect-URI/consent saga) → events_docs/setup/GMAIL.md
# EVENTS_OAUTH_BOX_CLIENT_ID=<box-client-id>
# EVENTS_OAUTH_BOX_CLIENT_SECRET=<box-client-secret>
# EVENTS_OAUTH_SLACK_CLIENT_ID=<slack-client-id>
# EVENTS_OAUTH_SLACK_CLIENT_SECRET=<slack-client-secret>
EVENTS_OAUTH_SLACK_SCOPES=chat:write channels:read channels:history
# EVENTS_OAUTH_GMAIL_CLIENT_ID=<gmail-client-id>.apps.googleusercontent.com
# EVENTS_OAUTH_GMAIL_CLIENT_SECRET=<gmail-client-secret>

# ── Backend selection flags (TENANT) ──
EVENTS_BOX_BACKEND=direct                        # box: direct token poll (opt-in). unset/"ap" = AP OAuth push
# EVENTS_SLACK_BACKEND=                           # unset = direct (default). "ap" = the parked AP path
# EVENTS_DISCORD_BACKEND=                         # unset = direct gateway (default). "ap" = AP polling


# ────────────────────────────────  USER  ──────────────────────────────────
# Your personal per-user logins. Single-operator: fill these in. Multi-user:
# leave blank — each person connects their own in the Studio (stored in AP as
# ea::<tenant>::<user>::<app>).

# ── GitHub — your Personal Access Token (repo scope) [USER] ──   setup → events_docs/setup/GITHUB.md
GITHUB_TOKEN=<github-pat>                         # or connect in the Studio

# ── Box — your Developer Token (~60 min, single account) [USER · direct-poll opt-in] ──   setup → events_docs/setup/BOX.md
BOX_DEV_TOKEN=<box-dev-token>                     # EXPIRES ~60 min — regenerate in the Box console

# ── Telegram — your personal chat id (DM / capture target) [USER] ──   setup → events_docs/setup/TELEGRAM.md
TELEGRAM_CHAT_ID=<your-telegram-chat-id>

# ── Gmail — NO static token here (Gmail is OAuth). Set the TENANT app creds above,
#    then log in ONCE via the Studio wizard (Integrations → Gmail → Connect). Your
#    token is stored in AP after consent — nothing to paste in this file. [USER via wizard]
#    setup (redirect-URI + consent walkthrough) → events_docs/setup/GMAIL.md
