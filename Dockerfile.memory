# Build a production memory image with all runtime artifacts available offline.
# Network access is needed while building, but startup only needs cluster-local PostgreSQL.
ARG BASE_IMAGE=registry.access.redhat.com/ubi9/python-312-minimal:latest
ARG NODE_IMAGE=node:22-bookworm-slim
ARG UV_IMAGE=ghcr.io/astral-sh/uv:latest

FROM ${UV_IMAGE} AS uv-tools

FROM ${NODE_IMAGE} AS frontend-builder

WORKDIR /workspace
COPY src/frontend_workspaces/ ./
RUN corepack enable \
    && corepack prepare pnpm@10.28.0 --activate \
    && pnpm install --frozen-lockfile \
    && NODE_ENV=production pnpm --filter ./frontend build

FROM ${BASE_IMAGE} AS python-builder

ARG EVOLVE_REF=af3e1310134b3397302e260cb3504b23a732fead

COPY --from=uv-tools /uv /usr/local/bin/uv
COPY --from=uv-tools /uvx /usr/local/bin/uvx

ENV PATH=/usr/local/bin:$PATH \
    FASTEMBED_CACHE_PATH=/app/.cache/fastembed \
    DOCLING_ARTIFACTS_PATH=/app/.cache/docling \
    HF_HOME=/app/.cache/huggingface \
    SENTENCE_TRANSFORMERS_HOME=/app/.cache/sentence-transformers \
    MODEL_PRELOAD_STRICT=1 \
    PRELOAD_EVOLVE_MODELS=1

USER root
WORKDIR /app

COPY pyproject.toml uv.lock README.md ./
COPY src/ ./src/
COPY --from=frontend-builder /workspace/frontend/dist/ ./src/cuga/frontend/dist/

RUN find src -name "*.egg-info" -o -name "build" -exec rm -rf {} + \
    && uv sync --no-editable --no-dev --extra observability \
    && uv pip install --python /app/.venv/bin/python \
        "altk-evolve[hooks,pii-regex] @ https://github.com/AgentToolkit/altk-evolve/archive/${EVOLVE_REF}.tar.gz"

# Required by the trusted model code shipped with nomic-ai/CodeRankEmbed.
RUN uv pip install --python /app/.venv/bin/python einops==0.8.1

RUN rm -rf /app/.venv/lib/python3.12/site-packages/torch/test \
           /app/.venv/lib/python3.12/site-packages/torch/include \
    && find /app/.venv -type f \( -name "*.so" -o -name "*.so.*" \) \
        -exec strip --strip-unneeded {} \; 2>/dev/null || true

RUN PLAYWRIGHT_BROWSERS_PATH=/app/.playwright uv run --no-sync playwright install --only-shell chromium
RUN uv run --no-sync python src/scripts/preload_models.py
RUN find /app/.venv -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true

FROM ${BASE_IMAGE}

USER root
RUN microdnf install -y \
        alsa-lib \
        at-spi2-atk \
        at-spi2-core \
        atk \
        cairo \
        dbus-libs \
        expat \
        glib2 \
        libdrm \
        libgbm \
        libX11 \
        libXcomposite \
        libXdamage \
        libXext \
        libXfixes \
        libXrandr \
        libxcb \
        libxkbcommon \
        mesa-libgbm \
        mesa-libGL \
        nspr \
        nss \
        nss-util \
        pango \
        --setopt=install_weak_deps=0 \
    && microdnf clean all

COPY --from=uv-tools /uv /usr/local/bin/uv
COPY --from=uv-tools /uvx /usr/local/bin/uvx

WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY --from=python-builder --chown=1001:0 --chmod=0775 /app/.venv /app/.venv
COPY --from=python-builder --chown=1001:0 --chmod=0775 /app/.playwright /app/.playwright
COPY --from=python-builder --chown=1001:0 --chmod=0775 /app/.cache /app/.cache
COPY --from=python-builder --chown=1001:0 --chmod=0775 /app/src /app/src
COPY --chown=1001:0 --chmod=0775 \
    src/cuga/demo_tools/huggingface/contacts.txt \
    src/cuga/demo_tools/huggingface/cuga_knowledge.md \
    src/cuga/demo_tools/huggingface/cuga_playbook.md \
    src/cuga/demo_tools/huggingface/email_template.md \
    src/cuga/demo_tools/huggingface/sovereign_core_overview.pdf \
    /app/cuga_workspace/
COPY --chown=1001:0 --chmod=0755 scripts/docker-entrypoint.sh /app/scripts/docker-entrypoint.sh
COPY --chown=1001:0 --chmod=0755 scripts/memory-image-supervisor.py /app/scripts/memory-image-supervisor.py

RUN mkdir -p /app/cuga_workspace /app/crm_tmp /app/.cuga/knowledge /data/dbs /data/evolve \
    && chown -R 1001:0 /data /app/.cuga /app/cuga_workspace /app/crm_tmp \
    && chmod -R g+rwX /data /app/.cuga /app/cuga_workspace /app/crm_tmp

USER 1001

EXPOSE 7860 8201

ENV USER=cuga \
    LOGNAME=cuga \
    HOME=/tmp \
    PATH=/app/.venv/bin:/usr/local/bin:$PATH \
    CUGA_HOST=0.0.0.0 \
    DYNACONF_SERVER_PORTS__DEMO=7860 \
    CUGA_DEMO_MODE=default \
    CUGA_LOGGING_DIR=/tmp/cuga-logging \
    CUGA_DBS_DIR=/data/dbs \
    DYNACONF_CRM_DB_PATH=/tmp/crm_tmp/crm_db_default \
    PLAYWRIGHT_BROWSERS_PATH=/app/.playwright \
    FASTEMBED_CACHE_PATH=/app/.cache/fastembed \
    DOCLING_ARTIFACTS_PATH=/app/.cache/docling \
    HF_HOME=/app/.cache/huggingface \
    SENTENCE_TRANSFORMERS_HOME=/app/.cache/sentence-transformers \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    HF_DATASETS_OFFLINE=1 \
    LITELLM_LOCAL_MODEL_COST_MAP=true \
    UV_OFFLINE=1 \
    PIP_NO_INDEX=1 \
    DYNACONF_EVOLVE__ENABLED=true \
    DYNACONF_EVOLVE__MODE=direct \
    DYNACONF_EVOLVE__URL=http://127.0.0.1:8201/sse \
    EVOLVE_BACKEND=postgres \
    EVOLVE_NAMESPACE_ID=evolve

HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
    CMD ["/app/.venv/bin/python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:7860/health', timeout=3)"]

ENTRYPOINT ["/app/.venv/bin/python", "/app/scripts/memory-image-supervisor.py"]
CMD []
