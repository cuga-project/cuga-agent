    {
      "id": "https://json-schema.org/understanding-json-schema/reference/conditionals#dependentrequired:POST:/credit-card",
      "source": "https://json-schema.org/understanding-json-schema/reference/conditionals#dependentrequired",
      "kind": "openapi",
      "method": "POST",
      "path": "/credit-card",
      "operation_id": "creditCardBilling",
      "input_schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "credit_card": {
            "type": "number"
          },
          "billing_address": {
            "type": "string"
          }
        },
        "dependentRequired": {
          "credit_card": ["billing_address"]
        }
      }
    },
    {
      "id": "https://json-schema.org/understanding-json-schema/reference/conditionals#if-then-else:POST:/membership",
      "source": "https://json-schema.org/understanding-json-schema/reference/conditionals#if-then-else",
      "kind": "openapi",
      "method": "POST",
      "path": "/membership",
      "operation_id": "membershipByCountry",
      "input_schema": {
        "type": "object",
        "properties": {
          "country": {
            "type": "string",
            "default": "United States of America"
          },
          "postal_code": {
            "type": "string"
          }
        },
        "if": {
          "properties": {
            "country": {
              "const": "United States of America"
            }
          }
        },
        "then": {
          "properties": {
            "postal_code": {
              "pattern": "[0-9]{5}(-[0-9]{4})?"
            }
          }
        },
        "else": {
          "properties": {
            "postal_code": {
              "pattern": "[A-Z][0-9][A-Z] [0-9][A-Z][0-9]"
            }
          }
        }
      }
    },
    {
      "id": "https://datatracker.ietf.org/doc/html/rfc7946#section-3.1.2:POST:/geojson-point",
      "source": "https://datatracker.ietf.org/doc/html/rfc7946#section-3.1.2",
      "kind": "openapi",
      "method": "POST",
      "path": "/geojson-point",
      "operation_id": "createGeoJsonPoint",
      "input_schema": {
        "type": "object",
        "properties": {
          "coordinates": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              }
            ],
            "minItems": 2,
            "maxItems": 3
          }
        },
        "required": ["coordinates"]
      }
    },
    {
      "id": "https://kubernetes.io/docs/concepts/configuration/manage-resources-containers/:POST:/pod-resources",
      "source": "https://kubernetes.io/docs/concepts/configuration/manage-resources-containers/",
      "kind": "openapi",
      "method": "POST",
