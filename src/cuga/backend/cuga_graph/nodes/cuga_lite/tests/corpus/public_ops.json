      "source": "https://json.schemastore.org/json-patch.json",
      "kind": "openapi",
      "method": "POST",
      "path": "/json-patch",
      "operation_id": "applyJsonPatch",
      "input_schema": {
        "type": "object",
        "properties": {
          "_body": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "const": "remove"
                },
