# Generated by scripts/build_kogito_app.sh — edit the template under
# src/cuga/backend/server/kogito/, not the generated project.
#
# Placeholders: @HTTP_PORT@

# Quarkus defaults to 8080, which the Flowable demo container also uses. Keep Kogito
# apps off it, and make sure the app's workflow_engine.url matches whatever is set here.
quarkus.http.port=@HTTP_PORT@

# The embedded Data Index pulls in OIDC and refuses to start without an auth server URL,
# even when unused. Disable the tenant and give the URL a value it will never dial.
quarkus.oidc.tenant-enabled=false
quarkus.oidc.auth-server-url=http://localhost/disabled

# The Kogito Management Console is a browser app served from its own port, so its calls to
# this service's /graphql are cross-origin — without CORS the browser drops the response
# and the console reports "Could not communicate with runtime". Any localhost port is
# allowed; tighten this before exposing a service beyond a dev machine.
quarkus.http.cors=true
quarkus.http.cors.origins=/https?://localhost(:[0-9]+)?/
quarkus.http.cors.methods=GET,POST,OPTIONS
quarkus.http.cors.headers=content-type,authorization
