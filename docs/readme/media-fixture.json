          "name": "Protect customer records",
          "description": "Block requests to delete CRM records.",
          "policy_type": "intent_guard",
          "enabled": true,
          "triggers": [
            {
              "type": "keyword",
              "value": [
                "delete",
                "erase"
              ],
              "target": "intent",
              "operator": "or",
              "case_sensitive": false
            }
          ],
          "response": {
            "response_type": "natural_language",
            "content": "Customer record deletion is outside the scope of this agent."
          },
          "allow_override": false,
          "priority": 100
        },
        {
          "id": "approve_updates",
          "name": "Approve CRM updates",
          "description": "Require human approval before updating customer accounts.",
          "policy_type": "tool_approval",
          "enabled": true,
          "triggers": [
            {
              "type": "always"
            }
