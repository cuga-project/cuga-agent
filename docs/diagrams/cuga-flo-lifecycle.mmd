sequenceDiagram
    autonumber
    participant Sup as Supervisor (CugaAgent)
    participant Deleg as delegation.py
    participant App as Application
    participant SC as supervisor_config.py
    participant FC as FlowConfig
    participant FA as FlowAgent
    participant Bridge as MCPFlowBridge
    participant Med as MCP2MCPMediator
    participant Ordo as MCPOrdo
    participant FS as FlowState
    participant TA as TaskAgent

    rect rgb(230, 240, 255)
        Note over App,Ordo: STARTUP — CUGA FLO to ORDO Lifecycle
        App->>App: sets DYNACONF_SUPERVISOR__CONFIG_PATH<br/>= supervisor_ordo.yaml
        App->>SC: load_supervisor_config(supervisor_ordo.yaml)
        SC->>SC: finds agent entry with type: flow_agent_ordo<br/>reads process_key: "loan_approval_stub"
        SC->>FC: load_ordo_flow_from_yaml(ordo_config.yaml, process_key)
        FC->>Bridge: <<create>> MCPFlowBridge(name="cuga-flo-bridge-ordo")
        Note right of Bridge: Empty FastMCP server — no registry, no engine yet
        FC->>Ordo: <<create>> MCPOrdo()
        Note right of Ordo: FastMCP server backed by WorkflowStubStore<br/>Acts as BOTH remote workflow engine AND process registry<br/>(API strictly based on external_mcp_engine/server.py)<br/>Tools: get_workflows, register_workflow,<br/>run_workflow, resume_workflow,<br/>stop_workflow, get_run_status
        FC->>Med: <<create>> MCP2MCPMediator(bridge, ordo, process_key)
        Med->>Bridge: register_registry(OrdoRegistryAdapter)
        Note right of Bridge: OrdoRegistryAdapter satisfies bridge's registry interface<br/>without ProcessRegistry — routes to MCPOrdo instead<br/>Adds MCP tools: register_flow, get_bpmn_process, get_flow_annotations
        Med->>Bridge: register_engine(_MediatorEngineAdapter)
        Note right of Bridge: Adds MCP tool: run_process<br/>Sets bridge._engine = _MediatorEngineAdapter
        FC->>Bridge: load_flow(ordo_config.yaml)
        Bridge->>Bridge: OrdoRegistryAdapter.register_flow()<br/>→ parses YAML, caches FlowConfig<br/>→ notify_fn(process_key, name)
        Bridge->>Med: _register_workflow_on_ordo(workflow_id, name)
        Med->>Ordo: ordo.store.register_workflow(workflow_id=process_key)
        Note right of Ordo: WorkflowSummary registered for "loan_approval_stub"<br/>Bridge has no direct MCPOrdo ref — mediator owns all MCPOrdo calls
        FC->>FA: <<create>> FlowAgent(process_key, bridge)
        FA->>Bridge: get_flow_annotations(process_key)
        Bridge-->>FA: FlowConfig (from OrdoRegistryAdapter cache)
        FA->>FA: config.create_task_agents() → task_agents<br/>config.create_task_policies() → task_policies
        Note right of FA: FlowAgent owns agent creation via bridge→OrdoRegistryAdapter→FlowConfig<br/>gateway_agents={}, hooks=[] (routing owned by remote engine)<br/>bridge passed explicitly → no auto-engine
        FA->>Bridge: register_flow_agent(self)
        Note right of Bridge: Registers MCP tools:<br/>execute_task, route_gateway, evaluate_hook
    end

    rect rgb(220, 235, 255)
        Note over Sup,FA: SUPERVISOR DELEGATION
        Sup->>Deleg: create_agent_delegation_func(adapter, "ordo_flow_agent", flow_agent)
        Note right of Deleg: agent_or_config is FlowAgent instance<br/>Detected via isinstance(agent_or_config, FlowAgent)
        Sup->>Deleg: delegate_to_agent(task, variables)
        Deleg->>FA: invoke(input_data=task, process_variables=vars_to_pass)
        FA-->>Deleg: FlowState
        Deleg->>Deleg: extract last message from FlowState.messages
        Deleg-->>Sup: answer string
    end

    rect rgb(230, 255, 230)
        Note over FA,Ordo: INVOCATION
        FA->>FA: invoke(input_data, process_variables)
        Note right of FA: Merges initial_variables + process_variables<br/>Sets initial_inputs["_user_message"] if str
        FA->>Bridge: run_process("loan_approval_stub", initial_inputs)
        Bridge->>Med: _MediatorEngineAdapter._run_via_mcp(...)<br/>→ Med._mediation_loop(process_key, initial_inputs, bridge._mcp)
        Note right of Med: Workflow already registered in MCPOrdo during STARTUP<br/>Opens async context: Client(FastMCPTransport(ordo._mcp))
        Med->>Ordo: call_tool("run_workflow", {workflow_id: "loan_approval_stub"})
        Note right of Ordo: WorkflowStubStore creates session_id<br/>Builds AgentGoal {agent_name: "credit_checker"}<br/>session status = "paused"
        Ordo-->>Med: RunResult {agent_goal: AgentGoal}
    end

    rect rgb(255, 245, 220)
        Note over Med,TA: MEDIATED TASK EXECUTION (per agent_goal pause)
        loop while RunResult.agent_goal is not None
            Med->>Med: _build_ctx(goal, process_key, accumulated_vars)
            Note right of Med: Synthesises ControlPointContext from AgentGoal:<br/>element_id = goal.agent_name ("credit_checker")<br/>current_state.process_variables = merged vars<br/>process_instance_id = goal.workflow_session_id
            Note right of Med: Opens nested client: Client(FastMCPTransport(bridge._mcp))
            Med->>Bridge: call_tool("execute_task", {task_id, ctx})
            Bridge->>FA: _handle_task("credit_checker", ctx)
            Note right of FA: WHO: self.task_agents["credit_checker"]<br/>HOW: self.task_policies["credit_checker"]<br/>WHAT: ctx.current_state.process_variables
            FA->>FA: _build_task_input(task_id, ctx)
            FA->>TA: execute(ctx.current_state, task_input)
            Note right of TA: CugaAgent runs with credit-check policy<br/>Returns JSON with credit_score + explanation<br/>output_mapping: credit_score → process_variables
            TA-->>FA: task result dict
            FA-->>Bridge: partial dict {task_results, process_variables}
            Bridge-->>Med: agent_response (task result dict)
            Med->>Med: merge output_variables into accumulated_vars
            Med->>Ordo: call_tool("resume_workflow", {session_id, agent_response})
            Note right of Ordo: WorkflowStubStore updates session to "completed"<br/>Builds final_response string
            Ordo-->>Med: RunResult {final_response: "Workflow completed..."}
        end
    end

    rect rgb(240, 255, 240)
        Note over Med,FA: COMPLETION
        Med->>FS: FlowState(process_id, process_variables=accumulated_vars, is_complete=True)
        Med->>FS: messages = [{role: assistant, content: final_response}]
        Med-->>Bridge: (FlowState, stub BPMNProcess)
        Bridge-->>FA: {state: FlowState.model_dump(), bpmn: stub_bpmn.to_dict()}
        FA->>FS: FlowState.model_validate(result["state"])
        alt not is_halted
            FA->>FS: mark_complete()
        end
        FA->>FA: _build_completion_message(final_state, BPMNProcess.from_dict(result["bpmn"]))
        FA->>FS: messages.append(summary)
        FA-->>Deleg: FlowState
    end
