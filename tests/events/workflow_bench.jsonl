{"id": "inbox-refund", "given": {"source": "gmail", "event": "new_email", "payload": {"subject": "Refund for order 5512", "from": "cust@acme.com", "body": "I returned order 5512 two weeks ago and still have not been refunded. Please help."}}, "agent": "inbox_concierge", "expect": {"decision": "REFUND", "action": "gmail/reply_to_email", "answer_contains": ["5512", "refund"], "tool_used": "orders_lookup", "delivered_to": "gmail"}}
{"id": "inbox-outage-p1", "given": {"source": "gmail", "event": "new_email", "payload": {"subject": "URGENT: checkout is down in prod", "from": "ops@acme.com", "body": "Customers cannot check out. 500s across the board since 14:02. Revenue impacting."}}, "agent": "inbox_concierge", "expect": {"decision": "P1", "action": "gmail/reply_to_email", "answer_contains": ["acknowledged", "escalat"], "delivered_to": "slack"}}
{"id": "inbox-newsletter-skip", "given": {"source": "gmail", "event": "new_email", "payload": {"subject": "This week in AI — issue #212", "from": "newsletter@digest.io", "body": "Top stories, tools, and papers curated for you."}}, "agent": "inbox_concierge", "expect": {"decision": "SKIP", "action": null, "declines": true}}
{"id": "inbox-invoice-confirm", "given": {"source": "gmail", "event": "new_labeled_email", "config": {"label": "Invoices"}, "payload": {"subject": "Invoice INV-8841", "from": "billing@vendor.com", "body": "Please find attached invoice INV-8841 due Aug 30."}}, "agent": "inbox_concierge", "expect": {"decision": "INVOICE", "action": "gmail/reply_to_email", "answer_contains": ["INV-8841", "received"]}}
{"id": "pr-risky-needs-changes", "given": {"source": "github", "event": "new_pr", "config": {"repo": "acme/api"}, "payload": {"title": "Swap auth middleware for custom JWT check", "author": "dev1", "changed_files": 9, "additions": 420, "deletions": 12, "body": "Replaces the vetted auth lib with a hand-rolled JWT verify."}}, "agent": "pr_sentinel", "expect": {"decision": "NEEDS_CHANGES", "action": "github/create_comment", "answer_contains": ["auth", "security"], "tool_used": "code_review"}}
{"id": "pr-tiny-approve", "given": {"source": "github", "event": "new_pr", "config": {"repo": "acme/api"}, "payload": {"title": "Fix typo in README", "author": "dev2", "changed_files": 1, "additions": 1, "deletions": 1, "body": "Typo fix."}}, "agent": "pr_sentinel", "expect": {"decision": "APPROVE", "action": "github/create_comment", "answer_contains": ["LGTM"]}}
{"id": "email-to-github-issue", "given": {"source": "gmail", "event": "new_email", "config": {"repo": "acme/api"}, "payload": {"subject": "Bug: export button 500s on large datasets", "from": "user@acme.com", "body": "Clicking Export on a report with >10k rows returns a 500. Repro: open any big report, click Export."}}, "agent": "inbox_concierge", "expect": {"decision": "BUG", "action": "github/create_issue", "answer_contains": ["Export", "500", "repro"]}}
{"id": "branch-urgent-vs-draft", "given": {"source": "gmail", "event": "new_email", "payload": {"subject": "URGENT: contract deadline today", "from": "legal@partner.com", "body": "We need the signed contract back before 5pm today or the deal lapses."}}, "agent": "inbox_concierge", "expect": {"branch_taken": "urgent", "action": "gmail/reply_to_email", "answer_contains": ["today"]}}
{"id": "branch-normal-draft", "given": {"source": "gmail", "event": "new_email", "payload": {"subject": "Coffee next week?", "from": "friend@x.com", "body": "Want to grab coffee sometime next week? No rush."}}, "agent": "inbox_concierge", "expect": {"branch_taken": "else", "action": "gmail/create_draft_reply"}}
{"id": "finance-tool-forcing", "given": {"source": "gmail", "event": "new_email", "payload": {"subject": "What's our position worth now?", "from": "cfo@acme.com", "body": "Roughly what is 120 shares of AAPL worth at the current price?"}}, "agent": "finance_analyst", "expect": {"action": "gmail/reply_to_email", "answer_matches": "\\$[0-9,]{3,}", "tool_used": "finance", "requires_tool": true}}
{"id": "github-pr-to-email-digest", "given": {"source": "github", "event": "new_pr", "config": {"repo": "acme/api"}, "payload": {"title": "Add retry with backoff to the download client", "author": "dev3", "changed_files": 3, "additions": 84, "deletions": 12, "body": "Wraps the download call in exponential backoff."}}, "agent": "pr_sentinel", "expect": {"decision": "APPROVE", "action": "gmail/send_email", "answer_contains": ["retry", "backoff"], "delivered_to": "gmail"}}
